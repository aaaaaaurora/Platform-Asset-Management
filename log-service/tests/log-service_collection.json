		{
			"name": "3. Dettaglio Singolo Log (GET /api/logs/:id)",
			"item": [
				{
					"name": "Get Log By ID - Success o 404 coerente",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Poiché il DB di integrazione potrebbe non avere seed data inseriti via RabbitMQ prima di questo test,",
									"// accettiamo sia 200 (se l'ID estratto esiste) sia 404 (se il db è vuoto e ha usato il fallback).",
									"pm.test(\"Status code is 200 or 404\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
									"});",
									"if (pm.response.code === 200) {",
									"    pm.test(\"Response contains log details and payload\", function () {",
									"        var jsonData = pm.response.json();",
									"        pm.expect(jsonData).to.have.property('id');",
									"        pm.expect(jsonData).to.have.property('payload');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-User-Role",
								"value": "AMMINISTRATORE"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/logs/{{sample_log_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"logs",
								"{{sample_log_id}}"
							]
						}
					},
					"response": []
				},
