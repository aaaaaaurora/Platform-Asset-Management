				{
					"name": "Get Logs - Success Admin Paginato (Estrae Log ID o gestisce vuoto)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Response contains pagination fields\", function () {",
									"    pm.expect(jsonData).to.have.property('total_items');",
									"    pm.expect(jsonData).to.have.property('logs');",
									"    pm.expect(jsonData.logs).to.be.an('array');",
									"});",
									"if (jsonData.logs && jsonData.logs.length > 0) {",
									"    pm.collectionVariables.set(\"sample_log_id\", jsonData.logs[0].id);",
									"} else {",
									"    // Fallback ID fittizio valido sintatticamente se il db è vuoto",
									"    pm.collectionVariables.set(\"sample_log_id\", \"11111111-1111-1111-1111-111111111111\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-User-Role",
								"value": "AMMINISTRATORE"
							},
							{
								"key": "X-User-Id",
								"value": "admin-123"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/logs?limit=10&page=1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"logs"
							],
							"query": [
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "page",
									"value": "1"
								}
							]
						}
					},
					"response": []
				},
